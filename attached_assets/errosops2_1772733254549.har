            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1\" />\n    <title>Sistema de Gestão de Frota | Fleet Management System</title>\n    <meta name=\"description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas. Otimize sua operação com nosso sistema de gestão.\" />\n    <meta name=\"keywords\" content=\"gestão de frota, sistema logístico, controle de veículos, gerenciamento de motoristas, sistema de transporte\" />\n    <meta name=\"author\" content=\"Fleet Management System\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\" />\n    \n    <!-- Open Graph Tags -->\n    <meta property=\"og:title\" content=\"Sistema de Gestão de Frota | Fleet Management System\" />\n    <meta property=\"og:description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://frota-system.replit.app\" />\n    <meta property=\"og:image\" content=\"/og-image.jpg\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:locale\" content=\"pt_BR\" />\n    \n    <!-- Twitter Card Tags -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Sistema de Gestão de Frota\" />\n    <meta name=\"twitter:description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas.\" />\n    <meta name=\"twitter:image\" content=\"/og-image.jpg\" />\n    \n    <!-- Theme flash prevention: runs before React, applies dark class and background immediately -->\n    <script>\n      (function() {\n        try {\n          var theme = localStorage.getItem('theme');\n          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n          var isDark = theme === 'dark' || (!theme && prefersDark);\n          if (isDark) {\n            document.documentElement.classList.add('dark');\n            document.documentElement.style.backgroundColor = '#111827';\n            document.body && (document.body.style.backgroundColor = '#111827');\n          } else {\n            document.documentElement.style.backgroundColor = '#F9FAFB';\n            document.body && (document.body.style.backgroundColor = '#F9FAFB');\n          }\n        } catch (e) {}\n      })();\n    </script>\n\n    <!-- Theme Color -->\n    <meta name=\"theme-color\" content=\"#1f2937\" />\n    <meta name=\"msapplication-TileColor\" content=\"#1f2937\" />\n    <script type=\"module\" crossorigin src=\"/assets/index-DkK_2JhV.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-BqK5cng2.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <!-- This is a replit script which adds a banner on the top of the page when opened in development mode outside the replit environment -->\n    <script type=\"text/javascript\" src=\"https://replit.com/public/js/replit-dev-banner.js\"></script>\n  \n<script async id=\"netlify-rum-container\" src=\"/.netlify/scripts/rum\" data-netlify-rum-site-id=\"16215b71-ae51-4ec4-ac57-4694160199fa\" data-netlify-deploy-branch=\"main\" data-netlify-deploy-context=\"production\" data-netlify-cwv-token=\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzaXRlX2lkIjoiMTYyMTViNzEtYWU1MS00ZWM0LWFjNTctNDY5NDE2MDE5OWZhIiwiYWNjb3VudF9pZCI6IjY3ODAyZDJkYzJhODQyMzk0NGU4MzQyOSIsImRlcGxveV9pZCI6IjY5YTliZDI1Yjc3NzMxMDAwNzg4YWI4MSIsImlzc3VlciI6Im5mc2VydmVyIn0.Mh3cUviEvCRFa