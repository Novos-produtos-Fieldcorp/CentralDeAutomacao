d\":7559,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":172,\"data\":\"2026-03-08\",\"hora\":\"12:00:46\",\"quilometragem\":408103,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":102,\"motorista_id\":7559,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":173,\"data\":\"2026-03-09\",\"hora\":\"18:38:59\",\"quilometragem\":13500,\"observacoes\":\"Sim, fotos da avaria \",\"id_tipo_checklist\":1,\"veiculo_id\":42,\"motorista_id\":7566,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":174,\"data\":\"2026-03-14\",\"hora\":\"13:00:34\",\"quilometragem\":54359,\"observacoes\":\"Batida superior direita, arranho porta esquerda baú documentação, arranhão tampa do tanque pequenos arranhões parte superior esquerda, detalhes nas duas portas traseiras \",\"id_tipo_checklist\":1,\"veiculo_id\":38,\"motorista_id\":7664,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":175,\"data\":\"2026-03-16\",\"hora\":\"13:45:07\",\"quilometragem\":654321,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6800,\"motorista_id\":7663,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":176,\"data\":\"2026-03-16\",\"hora\":\"16:36:45\",\"quilometragem\":408634,\"observacoes\":\"O ar condicionado não está funcionando e com isso na chuva a dirigibilidade fica um pouco comprometida e quanto ao vidro do lado esquerdo que eu relatei que está quebrado na verdade é a canaleta da porta e também quero corrigir a resposta do extintor, na verdade não tem extintor \",\"id_tipo_checklist\":1,\"veiculo_id\":102,\"motorista_id\":6800,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":178,\"data\":\"2026-03-16\",\"hora\":\"18:08:42\",\"quilometragem\":61644,\"observacoes\":\"Retrovisor direito quebrado, ponta do baú lado direito amassado, risco e amassado lateral esquerda, amassado embaixo da lanterna traseira direita, arranhado lado direito no baú, arranhados proximo ao retrovisor lado direito, para choque dianteiro arranhado, sem as borrachas do teto, possui suporte para celular, e carregador 12V, lanterna traseira lado direito arranhada, lanterna traseira lado esquerdo arranhada, porta lado esquerdo arranhado próximo a fechadura, porta esquerda bau arranhada por dentro\",\"id_tipo_checklist\":1,\"veiculo_id\":41,\"motorista_id\":7569,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":177,\"data\":\"2026-03-16\",\"hora\":\"17:55:41\",\"quilometragem\":68983,\"observacoes\":\"O carro está precisando ser lavado pois está muito sujo, porta do baú está amassada e fica raspando na parte de baixo atrapalhando o fechamento da porta \",\"id_tipo_checklist\":1,\"veiculo_id\":42,\"motorista_id\":7439,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":180,\"data\":\"2026-03-20\",\"hora\":\"10:47:05\",\"quilometragem\":119320,\"observacoes\":\"Não \",\"id_tipo_checklist\":1,\"veiculo_id\":39,\"motorista_id\":7667,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":181,\"data\":\"2026-03-24\",\"hora\":\"17:07:17\",\"quilometragem\":432887,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6810,\"motorista_id\":7669,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":182,\"data\":\"2026-03-24\",\"hora\":\"17:21:50\",\"quilometragem\":901872,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6811,\"motorista_id\":7669,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":183,\"data\":\"2026-03-24\",\"hora\":\"17:54:38\",\"quilometragem\":144834,\"observacoes\":\"Veículo com multimídia, capas no branco e uma caixa de som.\",\"id_tipo_checklist\":1,\"veiculo_id\":6812,\"motorista_id\":6800,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":184,\"data\":\"2026-03-25\",\"hora\":\"16:23:45\",\"quilometragem\":56882,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":59,\"motorista_id\":94,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":190,\"data\":\"2026-03-30\",\"hora\":\"20:04:49\",\"quilometragem\":138712,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":7678,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":189,\"data\":\"2026-03-30\",\"hora\":\"19:57:24\",\"quilometragem\":138712,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":7678,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":188,\"data\":\"2026-03-30\",\"hora\":\"19:38:56\",\"quilometragem\":138711,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":7678,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":187,\"data\":\"2026-03-30\",\"hora\":\"10:42:42\",\"quilometragem\":138565,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":19,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":191,\"data\":\"2026-03-31\",\"hora\":\"10:40:27\",\"quilometragem\":138898,\"observacoes\":\"Eu coloquei o freio de mão como bom porém tem que dar outra regulada nele, coloquei também sem documento do veículo pois o que está aqui está vencido preciso que imprime um atualizado\",\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":7678,\"updated_at\":null,\"company_id\":1,\"status\":true}, \n {\"checklist_id\":192,\"data\":\"2026-03-31\",\"hora\":\"16:54:00\",\"quilometragem\":138898,\"observacoes\":null,\"id_tipo_checklist\":1,\"veiculo_id\":6396,\"motorista_id\":7678,\"updated_at\":null,\"company_id\":1,\"status\":true}]"
