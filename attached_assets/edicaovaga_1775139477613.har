o, lanterna traseira esquerda esta trincada \",\"id_tipo_checklist\":1,\"veiculo_id\":6418,\"motorista_id\":7439,\"updated_at\":null,\"company_id\":1,\"status\":true,\"motorista\":{\"cpf\": \"33448982806\", \"nome\": \"ADRIANO ANDERSON DA SILVA\", \"motorista_id\": 7439},\"veiculo\":{\"tipo\": null, \"marca\": \"FIAT\", \"placa\": \"Opp7c00\", \"veiculo_id\": 6418},\"acessorios_veiculos\":[{\"pneu\": 6, \"estepe\": 16, \"macaco\": 16, \"cadeado\": 17, \"extintor\": 17, \"pneu_ruim\": \"Traseiro direito \", \"triangulo\": 16, \"chave_roda\": 16, \"checklist_id\": 139, \"id_acessorio\": 125, \"chave_reserva\": 17, \"carrinho_carga\": null, \"manual_veiculo\": 17, \"cartao_combustivel\": 17, \"documento_veicular\": 16}],\"componentes_gerais\":[],\"farol_veiculo\":[{\"auxiliar\": 1, \"dianteiro\": 1, \"luz_placa\": 1, \"checklist_id\": 139, \"pisca_traseiro\": 1, \"pisca_dianteiro\": 1, \"id_farol_veiculo\": 122, \"lanterna_traseira\": 1, \"luz_indicador_painel\": \"Tudo ok\"}],\"fluido_veiculo\":[{\"oleo_motor\": 14, \"checklist_id\": 139, \"fluido_freio\": 15, \"agua_radiador\": 15, \"agua_parabrisa\": 15, \"oleo_hidraulico\": 15, \"id_fluido_veiculo\": 134, \"liq_arrefecimento\": 15}]}, \n {\"checklist_id\":138,\"data\":\"2025-10-23\",\"hora\":\"09:30:32\",\"quilometragem\":37368,\"observacoes\":\"a bateria zera com facilidade, o alinhamento da geometria da direção nao está bom, a porta do motorista trava sozinha quando fecha o veículo, o freio está fazendo um barulho às vezes quando freio pra entrar nas curvas, o estepe está furado\",\"id_tipo_checklist\":1,\"veiculo_id\":59,\"motorista_id\":7437,\"updated_at\":null,\"company_id\":1,\"status\":true,\"motorista\":{\"cpf\": \"47620984852\", \"nome\": \"MARCELO FELIPE DA SILVA\", \"motorista_id\": 7437},\"veiculo\":{\"tipo\": null, \"marca\": \"FIAT\", \"placa\": \"OPP7C00\", \"veiculo_id\": 59},\"acessorios_veiculos\":[{\"pneu\": 3, \"estepe\": 17, \"macaco\": 16, \"cadeado\": 17, \"extintor\": 17, \"pneu_ruim\": \"Nã