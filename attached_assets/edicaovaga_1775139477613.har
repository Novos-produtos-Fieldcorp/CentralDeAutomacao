            "text": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1\" />\n    <title>Sistema de Gestão de Frota | Fleet Management System</title>\n    <meta name=\"description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas. Otimize sua operação com nosso sistema de gestão.\" />\n    <meta name=\"keywords\" content=\"gestão de frota, sistema logístico, controle de veículos, gerenciamento de motoristas, sistema de transporte\" />\n    <meta name=\"author\" content=\"Fleet Management System\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/favicon.ico\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\" />\n    \n    <!-- Open Graph Tags -->\n    <meta property=\"og:title\" content=\"Sistema de Gestão de Frota | Fleet Management System\" />\n    <meta property=\"og:description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://frota-system.replit.app\" />\n    <meta property=\"og:image\" content=\"/og-image.jpg\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:locale\" content=\"pt_BR\" />\n    \n    <!-- Twitter Card Tags -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Sistema de Gestão de Frota\" />\n    <meta name=\"twitter:description\" content=\"Sistema completo de gerenciamento de frota - controle de motoristas, veículos, contratos e operações logísticas.\" />\n    <meta name=\"twitte