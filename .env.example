# Supabase Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session Configuration
SESSION_SECRET=your-session-secret-here

# Application Configuration
PORT=5000
NODE_ENV=production

# Vite Environment Variables (for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CHAT_API_URL=https://chat.wiseapp360.com
VITE_CHAT_API_KEY=your-chat-api-key
VITE_CHAT_ACCOUNT_ID=your-account-id

# AI Service Configuration
GROQ_API_KEY=your-groq-api-key

# Hub do Desenvolvedor - CPF lookup
# Get token at: https://www.hubdodesenvolvedor.com.br
HUB_CPF_TOKEN=your-hub-cpf-token

# FIPE - Vehicle plate lookup
# Get key at: https://www.fipeapi.com.br
# FIPE_API_KEY=your-fipe-api-key
