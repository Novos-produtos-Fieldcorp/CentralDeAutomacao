# Variáveis de ambiente para produção no Netlify
# Configure estas variáveis no painel do Netlify em Site Settings > Environment Variables

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Chat API
VITE_CHAT_API_URL=https://your-chat-api.com
VITE_CHAT_ACCOUNT_ID=your-account-id

# Environment
NODE_ENV=production